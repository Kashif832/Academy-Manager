# ─────────────────────────────────────────────────────────────────────────────
# Academy Manager — EXAMPLE environment/config file
# Copy this to ".env" (local) or set these as environment variables (production).
# Every setting is explained in one line. NEVER commit the filled-in real file.
# ─────────────────────────────────────────────────────────────────────────────

# The PostgreSQL database connection string. REQUIRED. (Local default shown.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/academy"

# Separate database used only by the automated integration tests. Local dev only.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/academy_test"

# Secret used to sign login cookies. REQUIRED. Use a long random value in prod.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-change-me-in-production-please-32bytes"

# Redis connection for shared rate-limiting across multiple app servers. OPTIONAL.
# Leave unset for a single instance (uses an in-memory limiter instead).
# REDIS_URL="redis://localhost:6379"

# Forces the login cookie's "Secure" flag on/off. OPTIONAL — leave unset.
# By default it is automatic: Secure only when the request is HTTPS (detected via
# the x-forwarded-proto header from your TLS proxy). Set "true" only if your proxy
# terminates HTTPS but does NOT forward that header.
# COOKIE_SECURE="true"

# Node environment. Set to "production" when deploying. OPTIONAL locally.
# NODE_ENV="production"
