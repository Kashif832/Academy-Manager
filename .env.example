# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL is the ONLY supported database (dev, CI and production).
# Local dev/test/CI run a real PostgreSQL via embedded-postgres:
#     npm run db:pg:start      # boots PostgreSQL on :5433, creates `academy`
#     npm run db:pg:stop
# Then point DATABASE_URL at it (this is the default the scripts print):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/academy"

# Separate database used by the PostgreSQL-backed integration tests.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/academy_test"

# ── Secrets ──────────────────────────────────────────────────────────────────
# Signs all session cookies. Generate a strong value for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-change-me-in-production-please-32bytes"

# ── Rate limiting (optional but recommended in production) ───────────────────
# When set, the rate limiter uses a shared Redis store so limits are enforced
# across ALL app instances. Unset -> in-process limiter (single instance only).
# REDIS_URL="redis://localhost:6379"

# ── Cookie Secure flag (optional) ────────────────────────────────────────────
# Auto by default: cookies are Secure only when the request is HTTPS (detected
# via x-forwarded-proto from your TLS proxy). Force with "true"/"false".
# Behind a proxy that terminates TLS, leave this unset — it just works.
# COOKIE_SECURE="true"
