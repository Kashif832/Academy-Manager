# Production environment for docker-compose. Copy to .env.production and fill in.
# NEVER commit the filled-in file.

# ── HTTPS domain (Caddy) ─────────────────────────────────────────────────────
DOMAIN=your.domain.com
ACME_EMAIL=you@example.com

# ── PostgreSQL (compose provisions this) ─────────────────────────────────────
POSTGRES_USER=academy
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=academy

# ── Session secret — REQUIRED, strong random ─────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-64-hex-chars

# ── Cookie Secure flag (optional) ────────────────────────────────────────────
# Leave unset behind Caddy/any TLS proxy (auto-detected from x-forwarded-proto).
# Set to "true" only if you terminate TLS without forwarding that header.
# COOKIE_SECURE=true
